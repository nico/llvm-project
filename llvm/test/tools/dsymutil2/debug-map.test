## The debug map is read from the stabs in the binary's symbol table: N_OSO
## starts an object file, N_FUN comes in pairs (address, then size), N_GSYM
## takes its address from the regular symbol of the same name, N_STSYM
## carries its own. A global without a regular symbol is dropped.

# RUN: yaml2obj %s -o %t
# RUN: dsymutil2 --dump-debug-map %t | FileCheck %s --match-full-lines \
# RUN:   --strict-whitespace

#      CHECK:object /nop/a.o
# CHECK-NEXT:  function _f: not found -> 0x1000, size 0x20
# CHECK-NEXT:  global _g: not found -> 0x4000
# CHECK-NEXT:  static _s: not found -> 0x4008
# CHECK-NEXT:object /nop/lib.a(b.o)
# CHECK-NEXT:  function _h: not found -> 0x1020, size 0x8
#  CHECK-NOT:{{.}}

# RUN: echo -n abcd > %t.bad
# RUN: not dsymutil2 %t.bad 2>&1 | FileCheck %s --check-prefix=BAD
# BAD: error: {{.*}}.bad: truncated or malformed Mach-O file

--- !mach-o
IsLittleEndian: true
FileHeader:
  magic:      0xFEEDFACF
  cputype:    0x0100000C
  cpusubtype: 0x00000000
  filetype:   0x00000002
  ncmds:      3
  sizeofcmds: 328
  flags:      0x00000000
  reserved:   0x00000000
LoadCommands:
  - cmd:      LC_SEGMENT_64
    cmdsize:  232
    segname:  __TEXT
    vmaddr:   0
    vmsize:   0x8000
    fileoff:  0
    filesize: 416
    maxprot:  5
    initprot: 5
    nsects:   2
    flags:    0
    Sections:
      - sectname:  __text
        segname:   __TEXT
        addr:      0x1000
        size:      0x28
        offset:    360
        align:     2
        reloff:    0
        nreloc:    0
        flags:     0x80000400
        reserved1: 0
        reserved2: 0
        reserved3: 0
      - sectname:  __data
        segname:   __DATA
        addr:      0x4000
        size:      0x10
        offset:    400
        align:     3
        reloff:    0
        nreloc:    0
        flags:     0x00000001
        reserved1: 0
        reserved2: 0
        reserved3: 0
  - cmd:      LC_SEGMENT_64
    cmdsize:  72
    segname:  __LINKEDIT
    vmaddr:   0x8000
    vmsize:   0x4000
    fileoff:  416
    filesize: 257
    maxprot:  1
    initprot: 1
    nsects:   0
    flags:    0
  - cmd:      LC_SYMTAB
    cmdsize:  24
    symoff:   416
    nsyms:    13
    stroff:   624
    strsize:  49
LinkEditData:
  NameList:
    - { n_strx: 1,  n_type: 0x64, n_sect: 0, n_desc: 0, n_value: 0 }      # N_SO
    - { n_strx: 6,  n_type: 0x66, n_sect: 0, n_desc: 1, n_value: 0 }      # N_OSO
    - { n_strx: 15, n_type: 0x24, n_sect: 1, n_desc: 0, n_value: 0x1000 } # N_FUN
    - { n_strx: 0,  n_type: 0x24, n_sect: 0, n_desc: 0, n_value: 0x20 }
    - { n_strx: 18, n_type: 0x20, n_sect: 0, n_desc: 0, n_value: 0 }      # N_GSYM
    - { n_strx: 21, n_type: 0x20, n_sect: 0, n_desc: 0, n_value: 0 }      # N_GSYM
    - { n_strx: 27, n_type: 0x26, n_sect: 2, n_desc: 0, n_value: 0x4008 } # N_STSYM
    - { n_strx: 0,  n_type: 0x64, n_sect: 1, n_desc: 0, n_value: 0 }      # N_SO
    - { n_strx: 30, n_type: 0x66, n_sect: 0, n_desc: 1, n_value: 0 }      # N_OSO
    - { n_strx: 46, n_type: 0x24, n_sect: 1, n_desc: 0, n_value: 0x1020 } # N_FUN
    - { n_strx: 0,  n_type: 0x24, n_sect: 0, n_desc: 0, n_value: 0x8 }
    - { n_strx: 0,  n_type: 0x64, n_sect: 1, n_desc: 0, n_value: 0 }      # N_SO
    - { n_strx: 18, n_type: 0x0E, n_sect: 2, n_desc: 0, n_value: 0x4000 } # _g
  StringTable:
    - ''
    - a.cc
    - /nop/a.o
    - _f
    - _g
    - _gone
    - _s
    - '/nop/lib.a(b.o)'
    - _h
