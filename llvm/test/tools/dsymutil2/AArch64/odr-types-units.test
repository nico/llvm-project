## A member function is the same in two copies of a type if, among other
## things, its parameters have types of the same kind. A parameter's type can
## be in another unit of the object file than the function: with LTO, an
## object file has several units, and a type is in one of them.
##
## a.o has two units. C is in the first and has a method with a parameter of
## type P, which is in the second. b.o has one unit with both, and defines
## C::method. The definition refers to the declaration, which is inside of
## C: it finds the same declaration in a.o's copy, and b.o keeps no C.

# RUN: rm -rf %t && split-file %s %t && cd %t
# RUN: llvm-mc -triple arm64-apple-macosx -filetype=obj a.s -o a.o
# RUN: llvm-mc -triple arm64-apple-macosx -filetype=obj a.s -o b.o \
# RUN:   --defsym SECOND=1
# RUN: %python %S/../Inputs/make-binary.py main \
# RUN:   object:a.o fn:_f:0x1000:4 object:b.o fn:_f:0x1004:4
# RUN: dsymutil2 main -o main.dSYM
# RUN: llvm-dwarfdump --verify main.dSYM
# RUN: llvm-dwarfdump --debug-info main.dSYM | FileCheck %s

# CHECK:      DW_TAG_compile_unit
# CHECK:        DW_TAG_structure_type
# CHECK-NEXT:     DW_AT_name ("C")
# CHECK:      0x[[#%.8x,METHOD:]]: DW_TAG_subprogram
# CHECK-NEXT:       DW_AT_name ("method")
# CHECK:            DW_TAG_formal_parameter
# CHECK-NEXT:         DW_AT_type (0x00000000[[#%.8x,P:]] "P")

# CHECK:      DW_TAG_compile_unit
# CHECK:      0x[[#P]]: DW_TAG_structure_type
# CHECK-NEXT:     DW_AT_name ("P")

# CHECK:      DW_TAG_compile_unit
# CHECK-NOT:      DW_AT_name
# CHECK:        DW_TAG_subprogram
# CHECK-NEXT:     DW_AT_specification (0x00000000[[#METHOD]] "_ZN1C6methodE1P")
# CHECK-NEXT:     DW_AT_low_pc (0x0000000000001004)
# CHECK-NOT:      DW_AT_name

#--- a.s
_f:
  ret

.section __DWARF,__debug_abbrev,regular,debug
## 1: compile_unit, with children: language
.byte 1, 0x11, 1,  0x13, 0x05,  0, 0
## 2: structure_type, with children: name, byte_size
.byte 2, 0x13, 1,  0x03, 0x0e,  0x0b, 0x0b,  0, 0
## 3: subprogram, with children: name, linkage_name, declaration, external
.byte 3, 0x2e, 1,  0x03, 0x0e,  0x6e, 0x0e,  0x3c, 0x19,  0x3f, 0x19,  0, 0
## 4: formal_parameter: type, in any unit
.byte 4, 0x05, 0,  0x49, 0x10,  0, 0
## 5: formal_parameter: type, in this unit
.byte 5, 0x05, 0,  0x49, 0x13,  0, 0
## 6: subprogram, with children: name, low_pc, high_pc
.byte 6, 0x2e, 1,  0x03, 0x0e,  0x11, 0x01,  0x12, 0x06,  0, 0
## 7: variable: name, type
.byte 7, 0x34, 0,  0x03, 0x0e,  0x49, 0x13,  0, 0
## 8: subprogram: specification, low_pc, high_pc
.byte 8, 0x2e, 0,  0x47, 0x13,  0x11, 0x01,  0x12, 0x06,  0, 0
## 9: structure_type: name, byte_size
.byte 9, 0x13, 0,  0x03, 0x0e,  0x0b, 0x0b,  0, 0
.byte 0

.macro struct_p
Lp:
  .byte 9                        ; struct P
  .long Lstr_p - Lstr
  .byte 1
.endm

.section __DWARF,__debug_info,regular,debug
Linfo:
Lcu:
.long Lcu_end - Lcu - 4
.short 4
.long 0
.byte 8
.byte 1                          ; compile_unit
.short 0x21                      ; DW_LANG_C_plus_plus_14
.ifdef SECOND
  struct_p
.endif
Lc:
  .byte 2                        ; struct C
  .long Lstr_c - Lstr
  .byte 1
Lmethod:
    .byte 3                      ; method
    .long Lstr_method - Lstr
    .long Lstr_method_linkage - Lstr
.ifdef SECOND
      .byte 5
      .long Lp - Lcu
.else
      .byte 4
      .long Lp - Linfo
.endif
    .byte 0
  .byte 0
.ifdef SECOND
  .byte 8                        ; C::method
  .long Lmethod - Lcu
  .quad _f
  .long 4
.else
  .byte 6                        ; f
  .long Lstr_f - Lstr
  .quad _f
  .long 4
    .byte 7                      ; v
    .long Lstr_v - Lstr
    .long Lc - Lcu
  .byte 0
.endif
.byte 0
Lcu_end:
.ifndef SECOND
Lcu2:
.long Lcu2_end - Lcu2 - 4
.short 4
.long 0
.byte 8
.byte 1                          ; compile_unit
.short 0x21                      ; DW_LANG_C_plus_plus_14
  struct_p
.byte 0
Lcu2_end:
.endif

.section __DWARF,__debug_str,regular,debug
Lstr:
Lstr_c:
  .asciz "C"
Lstr_p:
  .asciz "P"
Lstr_method:
  .asciz "method"
Lstr_method_linkage:
  .asciz "_ZN1C6methodE1P"
Lstr_f:
  .asciz "f"
Lstr_v:
  .asciz "v"
