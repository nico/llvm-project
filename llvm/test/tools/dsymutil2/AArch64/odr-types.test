## A C++ type with a name is the same type in every object file. The first
## object file that uses it keeps it, and the others refer to that copy.
##
## a.o and b.o are C++. Both have ns::A and a struct Hidden in a namespace
## without a name; b.o also has ns::B.
##  - a.o keeps ns::A. b.o does not: its variable "a" refers to a.o's copy,
##    with DW_FORM_ref_addr.
##  - Hidden is not the same type in the two files. Each keeps its own.
##  - b.o keeps ns::B, in an entry for ns of its own.
## c.o is the same as a.o, but in C, which has no such rule. It keeps its A.

# RUN: rm -rf %t && split-file %s %t && cd %t
# RUN: llvm-mc -triple arm64-apple-macosx -filetype=obj a.s -o a.o
# RUN: llvm-mc -triple arm64-apple-macosx -filetype=obj a.s -o b.o \
# RUN:   --defsym SECOND=1
# RUN: llvm-mc -triple arm64-apple-macosx -filetype=obj a.s -o c.o \
# RUN:   --defsym C=1
# RUN: %python %S/../Inputs/make-binary.py main \
# RUN:   object:a.o fn:_f:0x1000:4 object:b.o fn:_f:0x1004:4 \
# RUN:   object:c.o fn:_f:0x1008:4
# RUN: dsymutil2 main -o main.dSYM
# RUN: llvm-dwarfdump --debug-info main.dSYM | FileCheck %s

# CHECK:      DW_TAG_compile_unit
# CHECK-NEXT:   DW_AT_language (DW_LANG_C_plus_plus_14)
# CHECK:        DW_TAG_namespace
# CHECK-NEXT:     DW_AT_name ("ns")
# CHECK:      0x[[#%.8x,A:]]: DW_TAG_structure_type
# CHECK-NEXT:       DW_AT_name ("A")
# CHECK:        DW_TAG_namespace
# CHECK:      0x[[#%.8x,HIDDEN:]]: DW_TAG_structure_type
# CHECK-NEXT:       DW_AT_name ("Hidden")
# CHECK:        DW_TAG_subprogram
# CHECK:          DW_TAG_variable
# CHECK-NEXT:       DW_AT_name ("a")
# CHECK-NEXT:       DW_AT_type (0x[[#A]] "ns::A")
# CHECK:          DW_TAG_variable
# CHECK-NEXT:       DW_AT_name ("h")
# CHECK-NEXT:       DW_AT_type (0x[[#HIDDEN]] "(anonymous namespace)::Hidden")

# CHECK:      DW_TAG_compile_unit
# CHECK-NEXT:   DW_AT_language (DW_LANG_C_plus_plus_14)
# CHECK:        DW_TAG_namespace
# CHECK-NEXT:     DW_AT_name ("ns")
# CHECK-NOT:      DW_AT_name ("A")
# CHECK:          DW_TAG_structure_type
# CHECK-NEXT:       DW_AT_name ("B")
# CHECK:        DW_TAG_namespace
# CHECK:      0x[[#%.8x,HIDDEN2:]]: DW_TAG_structure_type
# CHECK-NEXT:       DW_AT_name ("Hidden")
# CHECK:        DW_TAG_subprogram
# CHECK:          DW_TAG_variable
# CHECK-NEXT:       DW_AT_name ("a")
# CHECK-NEXT:       DW_AT_type (0x00000000[[#A]] "ns::A")
# CHECK:          DW_TAG_variable
# CHECK-NEXT:       DW_AT_name ("h")
# CHECK-NEXT:       DW_AT_type (0x00000000[[#HIDDEN2]] "(anonymous namespace)::Hidden")
# CHECK:          DW_TAG_variable
# CHECK-NEXT:       DW_AT_name ("b")
# CHECK-NEXT:       DW_AT_type (0x{{[0-9a-f]+}} "ns::B")

# CHECK:      DW_TAG_compile_unit
# CHECK-NEXT:   DW_AT_language (DW_LANG_C99)
# CHECK:        DW_TAG_namespace
# CHECK-NEXT:     DW_AT_name ("ns")
# CHECK:      0x[[#%.8x,A3:]]: DW_TAG_structure_type
# CHECK-NEXT:       DW_AT_name ("A")
# CHECK:          DW_TAG_variable
# CHECK-NEXT:       DW_AT_name ("a")
# CHECK-NEXT:       DW_AT_type (0x[[#A3]] "ns::A")

#--- a.s
_f:
  ret

.section __DWARF,__debug_abbrev,regular,debug
## 1: compile_unit, with children: language
.byte 1, 0x11, 1,  0x13, 0x05,  0, 0
## 2: namespace, with children: name
.byte 2, 0x39, 1,  0x03, 0x0e,  0, 0
## 3: namespace, with children
.byte 3, 0x39, 1,  0, 0
## 4: structure_type, with children: name, byte_size, decl_file, decl_line
.byte 4, 0x13, 1,  0x03, 0x0e,  0x0b, 0x0b,  0x3a, 0x0b,  0x3b, 0x0b,  0, 0
## 5: member: name, type
.byte 5, 0x0d, 0,  0x03, 0x0e,  0x49, 0x13,  0, 0
## 6: base_type: name, encoding, byte_size
.byte 6, 0x24, 0,  0x03, 0x0e,  0x3e, 0x0b,  0x0b, 0x0b,  0, 0
## 7: subprogram, with children: name, low_pc, high_pc
.byte 7, 0x2e, 1,  0x03, 0x0e,  0x11, 0x01,  0x12, 0x06,  0, 0
## 8: variable: name, type
.byte 8, 0x34, 0,  0x03, 0x0e,  0x49, 0x13,  0, 0
.byte 0

.section __DWARF,__debug_info,regular,debug
Lcu:
.long Lcu_end - Lcu - 4
.short 4
.long 0
.byte 8
.byte 1                          ; compile_unit
.ifdef C
.short 0x0c                      ; DW_LANG_C99
.else
.short 0x21                      ; DW_LANG_C_plus_plus_14
.endif
  .byte 2                        ; namespace ns
  .long Lstr_ns - Lstr
La:
    .byte 4                      ; struct A
    .long Lstr_a - Lstr
    .byte 4
## The number of the file is not the same in every unit.
.ifdef SECOND
    .byte 2
.else
    .byte 1
.endif
    .byte 10
      .byte 5                    ; x
      .long Lstr_x - Lstr
      .long Lint - Lcu
    .byte 0
.ifdef SECOND
Lb:
    .byte 4                      ; struct B
    .long Lstr_b - Lstr
    .byte 4
    .byte 1
    .byte 20
      .byte 5
      .long Lstr_x - Lstr
      .long Lint - Lcu
    .byte 0
.endif
  .byte 0
  .byte 3                        ; namespace
Lhidden:
    .byte 4                      ; struct Hidden
    .long Lstr_hidden - Lstr
    .byte 4
    .byte 1
    .byte 30
      .byte 5
      .long Lstr_x - Lstr
      .long Lint - Lcu
    .byte 0
  .byte 0
Lint:
  .byte 6                        ; int
  .long Lstr_int - Lstr
  .byte 5
  .byte 4
  .byte 7                        ; f
  .long Lstr_f - Lstr
  .quad _f
  .long 4
    .byte 8                      ; a
    .long Lstr_var_a - Lstr
    .long La - Lcu
    .byte 8                      ; h
    .long Lstr_var_h - Lstr
    .long Lhidden - Lcu
.ifdef SECOND
    .byte 8                      ; b
    .long Lstr_var_b - Lstr
    .long Lb - Lcu
.endif
  .byte 0
.byte 0
Lcu_end:

.section __DWARF,__debug_str,regular,debug
Lstr:
Lstr_ns:
  .asciz "ns"
Lstr_a:
  .asciz "A"
Lstr_b:
  .asciz "B"
Lstr_x:
  .asciz "x"
Lstr_hidden:
  .asciz "Hidden"
Lstr_int:
  .asciz "int"
Lstr_f:
  .asciz "f"
Lstr_var_a:
  .asciz "a"
Lstr_var_h:
  .asciz "h"
Lstr_var_b:
  .asciz "b"
