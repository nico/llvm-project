## A C++ type with a name is the same type in every object file. The first
## object file that uses it keeps it, and the others refer to that copy.
##
## a.o and b.o are C++. Both have ns::A, ns::E and a struct Hidden in a
## namespace without a name; b.o also has ns::B.
##  - a.o keeps ns::A. b.o does not: its variable "a" refers to a.o's copy,
##    with DW_FORM_ref_addr.
##  - b.o defines A::method. The definition refers to the declaration, which
##    is inside of A: it finds the same declaration in a.o's copy.
##  - b.o also defines E::extra, which only its own copy of E declares: an
##    implicit member, or an instance of a member template. So b.o keeps its
##    E for that. Its variable "e" still refers to a.o's.
##  - Hidden is not the same type in the two files. Each keeps its own.
##  - Plain is an instance of a template, and its name does not say which
##    one. Each keeps its own.
##  - b.o keeps ns::B, in an entry for ns of its own.
## c.o is the same as a.o, but in C, which has no such rule. It keeps its A.
## d.o is the same as b.o. It needs E::extra as well, and finds it in the
## copy of E that b.o kept for it: the first object file that needs a member
## that the owner's copy lacks has the spare copy. So d.o keeps nothing of
## ns: A and E are a.o's, B and E::extra are b.o's.

# RUN: rm -rf %t && split-file %s %t && cd %t
# RUN: llvm-mc -triple arm64-apple-macosx -filetype=obj a.s -o a.o
# RUN: llvm-mc -triple arm64-apple-macosx -filetype=obj a.s -o b.o \
# RUN:   --defsym SECOND=1
# RUN: llvm-mc -triple arm64-apple-macosx -filetype=obj a.s -o c.o \
# RUN:   --defsym C=1
# RUN: %python %S/../Inputs/make-binary.py main \
# RUN:   object:a.o fn:_f:0x1000:4 \
# RUN:   object:b.o fn:_f:0x1004:4 fn:_g:0x1008:4 fn:_h:0x100c:4 \
# RUN:   object:c.o fn:_f:0x1010:4 \
# RUN:   object:b.o fn:_f:0x1014:4 fn:_g:0x1018:4 fn:_h:0x101c:4
# RUN: dsymutil2 main -o main.dSYM
# RUN: llvm-dwarfdump --debug-info main.dSYM | FileCheck %s

# CHECK:      DW_TAG_compile_unit
# CHECK-NEXT:   DW_AT_language (DW_LANG_C_plus_plus_14)
# CHECK:        DW_TAG_namespace
# CHECK-NEXT:     DW_AT_name ("ns")
# CHECK:      0x[[#%.8x,A:]]: DW_TAG_structure_type
# CHECK-NEXT:       DW_AT_name ("A")
# CHECK:      0x[[#%.8x,METHOD:]]: DW_TAG_subprogram
# CHECK-NEXT:         DW_AT_name ("method")
# CHECK:      0x[[#%.8x,E:]]: DW_TAG_structure_type
# CHECK-NEXT:       DW_AT_name ("E")
# CHECK-NOT:          DW_AT_name ("extra")
# CHECK:        DW_TAG_namespace
# CHECK:      0x[[#%.8x,HIDDEN:]]: DW_TAG_structure_type
# CHECK-NEXT:       DW_AT_name ("Hidden")
# CHECK:        DW_TAG_structure_type
# CHECK-NEXT:     DW_AT_name ("Plain")
# CHECK:        DW_TAG_subprogram
# CHECK:          DW_TAG_variable
# CHECK-NEXT:       DW_AT_name ("a")
# CHECK-NEXT:       DW_AT_type (0x[[#A]] "ns::A")
# CHECK:          DW_TAG_variable
# CHECK-NEXT:       DW_AT_name ("h")
# CHECK-NEXT:       DW_AT_type (0x[[#HIDDEN]] "(anonymous namespace)::Hidden")
# CHECK:          DW_TAG_variable
# CHECK-NEXT:       DW_AT_name ("e")
# CHECK-NEXT:       DW_AT_type (0x[[#E]] "ns::E")

# CHECK:      DW_TAG_compile_unit
# CHECK-NEXT:   DW_AT_language (DW_LANG_C_plus_plus_14)
# CHECK:        DW_TAG_namespace
# CHECK-NEXT:     DW_AT_name ("ns")
# CHECK-NOT:      DW_AT_name ("A")
# CHECK:      0x[[#%.8x,B:]]: DW_TAG_structure_type
# CHECK-NEXT:       DW_AT_name ("B")
# CHECK:          DW_TAG_structure_type
# CHECK-NEXT:       DW_AT_name ("E")
# CHECK:      0x[[#%.8x,EXTRA:]]: DW_TAG_subprogram
# CHECK-NEXT:         DW_AT_name ("extra")
# CHECK:        DW_TAG_namespace
# CHECK:      0x[[#%.8x,HIDDEN2:]]: DW_TAG_structure_type
# CHECK-NEXT:       DW_AT_name ("Hidden")
# CHECK:      0x[[#%.8x,PLAIN2:]]: DW_TAG_structure_type
# CHECK-NEXT:     DW_AT_name ("Plain")
# CHECK:        DW_TAG_subprogram
# CHECK:          DW_TAG_variable
# CHECK-NEXT:       DW_AT_name ("a")
# CHECK-NEXT:       DW_AT_type (0x00000000[[#A]] "ns::A")
# CHECK:          DW_TAG_variable
# CHECK-NEXT:       DW_AT_name ("h")
# CHECK-NEXT:       DW_AT_type (0x00000000[[#HIDDEN2]] "(anonymous namespace)::Hidden")
# CHECK:          DW_TAG_variable
# CHECK-NEXT:       DW_AT_name ("e")
# CHECK-NEXT:       DW_AT_type (0x00000000[[#E]] "ns::E")
# CHECK:          DW_TAG_variable
# CHECK-NEXT:       DW_AT_name ("p")
# CHECK-NEXT:       DW_AT_type (0x00000000[[#PLAIN2]] "Plain<int>")
# CHECK:          DW_TAG_variable
# CHECK-NEXT:       DW_AT_name ("b")
# CHECK-NEXT:       DW_AT_type (0x00000000[[#B]] "ns::B")
# CHECK:        DW_TAG_subprogram
# CHECK-NEXT:     DW_AT_specification (0x00000000[[#METHOD]] "_ZN2ns1A6methodEv")
# CHECK-NEXT:     DW_AT_low_pc (0x0000000000001008)
# CHECK:        DW_TAG_subprogram
# CHECK-NEXT:     DW_AT_specification (0x00000000[[#EXTRA]] "_ZN2ns1E5extraEv")
# CHECK-NEXT:     DW_AT_low_pc (0x000000000000100c)

# CHECK:      DW_TAG_compile_unit
# CHECK-NEXT:   DW_AT_language (DW_LANG_C99)
# CHECK:        DW_TAG_namespace
# CHECK-NEXT:     DW_AT_name ("ns")
# CHECK:      0x[[#%.8x,A3:]]: DW_TAG_structure_type
# CHECK-NEXT:       DW_AT_name ("A")
# CHECK:          DW_TAG_variable
# CHECK-NEXT:       DW_AT_name ("a")
# CHECK-NEXT:       DW_AT_type (0x[[#A3]] "ns::A")

# CHECK:      DW_TAG_compile_unit
# CHECK-NEXT:   DW_AT_language (DW_LANG_C_plus_plus_14)
# CHECK-NOT:      DW_AT_name ("ns")
# CHECK-NOT:      DW_AT_name ("E")
# CHECK:      0x[[#%.8x,HIDDEN4:]]: DW_TAG_structure_type
# CHECK-NEXT:       DW_AT_name ("Hidden")
# CHECK:      0x[[#%.8x,PLAIN4:]]: DW_TAG_structure_type
# CHECK-NEXT:     DW_AT_name ("Plain")
# CHECK:        DW_TAG_subprogram
# CHECK:          DW_TAG_variable
# CHECK-NEXT:       DW_AT_name ("a")
# CHECK-NEXT:       DW_AT_type (0x00000000[[#A]] "ns::A")
# CHECK:          DW_TAG_variable
# CHECK-NEXT:       DW_AT_name ("h")
# CHECK-NEXT:       DW_AT_type (0x00000000[[#HIDDEN4]] "(anonymous namespace)::Hidden")
# CHECK:          DW_TAG_variable
# CHECK-NEXT:       DW_AT_name ("e")
# CHECK-NEXT:       DW_AT_type (0x00000000[[#E]] "ns::E")
# CHECK:          DW_TAG_variable
# CHECK-NEXT:       DW_AT_name ("p")
# CHECK-NEXT:       DW_AT_type (0x00000000[[#PLAIN4]] "Plain<int>")
# CHECK:          DW_TAG_variable
# CHECK-NEXT:       DW_AT_name ("b")
# CHECK-NEXT:       DW_AT_type (0x00000000[[#B]] "ns::B")
# CHECK:        DW_TAG_subprogram
# CHECK-NEXT:     DW_AT_specification (0x00000000[[#METHOD]] "_ZN2ns1A6methodEv")
# CHECK-NEXT:     DW_AT_low_pc (0x0000000000001018)
# CHECK:        DW_TAG_subprogram
# CHECK-NEXT:     DW_AT_specification (0x00000000[[#EXTRA]] "_ZN2ns1E5extraEv")
# CHECK-NEXT:     DW_AT_low_pc (0x000000000000101c)

#--- a.s
_f:
  ret
_g:
  ret
_h:
  ret

.section __DWARF,__debug_abbrev,regular,debug
## 1: compile_unit, with children: language
.byte 1, 0x11, 1,  0x13, 0x05,  0, 0
## 2: namespace, with children: name
.byte 2, 0x39, 1,  0x03, 0x0e,  0, 0
## 3: namespace, with children
.byte 3, 0x39, 1,  0, 0
## 4: structure_type, with children: name, byte_size, decl_file, decl_line
.byte 4, 0x13, 1,  0x03, 0x0e,  0x0b, 0x0b,  0x3a, 0x0b,  0x3b, 0x0b,  0, 0
## 5: member: name, type
.byte 5, 0x0d, 0,  0x03, 0x0e,  0x49, 0x13,  0, 0
## 6: base_type: name, encoding, byte_size
.byte 6, 0x24, 0,  0x03, 0x0e,  0x3e, 0x0b,  0x0b, 0x0b,  0, 0
## 7: subprogram, with children: name, low_pc, high_pc
.byte 7, 0x2e, 1,  0x03, 0x0e,  0x11, 0x01,  0x12, 0x06,  0, 0
## 8: variable: name, type
.byte 8, 0x34, 0,  0x03, 0x0e,  0x49, 0x13,  0, 0
## 9: subprogram: name, linkage_name, declaration
.byte 9, 0x2e, 0,  0x03, 0x0e,  0x6e, 0x0e,  0x3c, 0x19,  0, 0
## 10: subprogram: specification, low_pc, high_pc
.byte 10, 0x2e, 0,  0x47, 0x13,  0x11, 0x01,  0x12, 0x06,  0, 0
## 11: template_type_parameter: type
.byte 11, 0x2f, 0,  0x49, 0x13,  0, 0
.byte 0

.section __DWARF,__debug_info,regular,debug
Lcu:
.long Lcu_end - Lcu - 4
.short 4
.long 0
.byte 8
.byte 1                          ; compile_unit
.ifdef C
.short 0x0c                      ; DW_LANG_C99
.else
.short 0x21                      ; DW_LANG_C_plus_plus_14
.endif
  .byte 2                        ; namespace ns
  .long Lstr_ns - Lstr
La:
    .byte 4                      ; struct A
    .long Lstr_a - Lstr
    .byte 4
## The number of the file is not the same in every unit.
.ifdef SECOND
    .byte 2
.else
    .byte 1
.endif
    .byte 10
      .byte 5                    ; x
      .long Lstr_x - Lstr
      .long Lint - Lcu
Lmethod:
      .byte 9                    ; method
      .long Lstr_method - Lstr
      .long Lstr_method_linkage - Lstr
    .byte 0
.ifdef SECOND
Lb:
    .byte 4                      ; struct B
    .long Lstr_b - Lstr
    .byte 4
    .byte 1
    .byte 20
      .byte 5
      .long Lstr_x - Lstr
      .long Lint - Lcu
    .byte 0
.endif
Le:
    .byte 4                      ; struct E
    .long Lstr_e - Lstr
    .byte 4
    .byte 1
    .byte 40
      .byte 5
      .long Lstr_x - Lstr
      .long Lint - Lcu
.ifdef SECOND
Lextra:
      .byte 9                    ; extra
      .long Lstr_extra - Lstr
      .long Lstr_extra_linkage - Lstr
.endif
    .byte 0
  .byte 0
  .byte 3                        ; namespace
Lhidden:
    .byte 4                      ; struct Hidden
    .long Lstr_hidden - Lstr
    .byte 4
    .byte 1
    .byte 30
      .byte 5
      .long Lstr_x - Lstr
      .long Lint - Lcu
    .byte 0
  .byte 0
Lplain:
  .byte 4                        ; struct Plain
  .long Lstr_plain - Lstr
  .byte 4
  .byte 1
  .byte 50
    .byte 11                     ; its template argument
    .long Lint - Lcu
  .byte 0
Lint:
  .byte 6                        ; int
  .long Lstr_int - Lstr
  .byte 5
  .byte 4
  .byte 7                        ; f
  .long Lstr_f - Lstr
  .quad _f
  .long 4
    .byte 8                      ; a
    .long Lstr_var_a - Lstr
    .long La - Lcu
    .byte 8                      ; h
    .long Lstr_var_h - Lstr
    .long Lhidden - Lcu
    .byte 8                      ; e
    .long Lstr_var_e - Lstr
    .long Le - Lcu
    .byte 8                      ; p
    .long Lstr_var_p - Lstr
    .long Lplain - Lcu
.ifdef SECOND
    .byte 8                      ; b
    .long Lstr_var_b - Lstr
    .long Lb - Lcu
.endif
  .byte 0
.ifdef SECOND
  .byte 10                       ; A::method
  .long Lmethod - Lcu
  .quad _g
  .long 4
  .byte 10                       ; E::extra
  .long Lextra - Lcu
  .quad _h
  .long 4
.endif
.byte 0
Lcu_end:

.section __DWARF,__debug_str,regular,debug
Lstr:
Lstr_ns:
  .asciz "ns"
Lstr_a:
  .asciz "A"
Lstr_b:
  .asciz "B"
Lstr_x:
  .asciz "x"
Lstr_hidden:
  .asciz "Hidden"
Lstr_int:
  .asciz "int"
Lstr_f:
  .asciz "f"
Lstr_var_a:
  .asciz "a"
Lstr_var_h:
  .asciz "h"
Lstr_var_b:
  .asciz "b"
Lstr_var_e:
  .asciz "e"
Lstr_var_p:
  .asciz "p"
Lstr_plain:
  .asciz "Plain"
Lstr_e:
  .asciz "E"
Lstr_method:
  .asciz "method"
Lstr_method_linkage:
  .asciz "_ZN2ns1A6methodEv"
Lstr_extra:
  .asciz "extra"
Lstr_extra_linkage:
  .asciz "_ZN2ns1E5extraEv"
