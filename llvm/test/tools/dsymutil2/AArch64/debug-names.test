## If one unit is DWARF 5, the dSYM has the table of names of DWARF 5,
## __debug_names, and not the four tables that came before it, as with
## dsymutil. The table is for all units, also those of the versions before:
## a.o is DWARF 5 and b.o DWARF 4 here.
##
## The table has the names that the three tables of names, namespaces and
## types would have, each with its entries: their tag, their unit and their
## offset in it. Both units have a function f<int>, which is also found
## as f. Its names are spelled out in the debug info, not offsets of strings.

# RUN: rm -rf %t && split-file %s %t && cd %t
# RUN: llvm-mc -triple arm64-apple-macosx -filetype=obj a.s -o a.o \
# RUN:   --defsym VERSION=5
# RUN: llvm-mc -triple arm64-apple-macosx -filetype=obj a.s -o b.o \
# RUN:   --defsym VERSION=4
# RUN: %python %S/../Inputs/make-binary.py main \
# RUN:   object:a.o fn:_f:0x1000:4 object:b.o fn:_f:0x1004:4
# RUN: dsymutil2 main -o main.dSYM
# RUN: llvm-dwarfdump --verify main.dSYM
# RUN: llvm-dwarfdump --debug-names main.dSYM | FileCheck %s \
# RUN:   --implicit-check-not=Decl
# RUN: llvm-objdump -h main.dSYM/Contents/Resources/DWARF/main \
# RUN:   | FileCheck %s --check-prefix=SECTIONS --implicit-check-not=__apple

# SECTIONS: __debug_names

# CHECK:      .debug_names contents:
# CHECK-NEXT: Name Index @ 0x0 {
# CHECK-NEXT:   Header {
# CHECK-NEXT:     Length:
# CHECK-NEXT:     Format: DWARF32
# CHECK-NEXT:     Version: 5
# CHECK-NEXT:     CU count: 2
# CHECK-NEXT:     Local TU count: 0
# CHECK-NEXT:     Foreign TU count: 0
# CHECK-NEXT:     Bucket count: 1
# CHECK-NEXT:     Name count: 6
# CHECK-NEXT:     Abbreviations table size:
# CHECK-NEXT:     Augmentation: 'LLVM0700'
# CHECK-NEXT:   }
# CHECK-NEXT:   Compilation Unit offsets [
# CHECK-NEXT:     CU[0]: 0x00000000
# CHECK-NEXT:     CU[1]: 0x{{[0-9a-f]+}}
# CHECK-NEXT:   ]
# CHECK-NEXT:   Abbreviations [
# CHECK-NEXT:     Abbreviation 0x1 {
# CHECK-NEXT:       Tag: DW_TAG_structure_type
# CHECK-NEXT:       DW_IDX_compile_unit: DW_FORM_data1
# CHECK-NEXT:       DW_IDX_die_offset: DW_FORM_ref4
# CHECK-NEXT:     }
# CHECK-NEXT:     Abbreviation 0x2 {
# CHECK-NEXT:       Tag: DW_TAG_base_type
# CHECK:          Abbreviation 0x3 {
# CHECK-NEXT:       Tag: DW_TAG_subprogram
# CHECK:          Abbreviation 0x4 {
# CHECK-NEXT:       Tag: DW_TAG_namespace
# CHECK:        Bucket 0 [

## The names are in the order of their hashes, read from the lowest bit up.
# CHECK:            String: {{.*}} "f<int>"
# CHECK-NEXT:       Entry @ {{.*}} {
# CHECK-NEXT:         Abbrev: 0x3
# CHECK-NEXT:         Tag: DW_TAG_subprogram
# CHECK-NEXT:         DW_IDX_compile_unit: 0x00
# CHECK-NEXT:         DW_IDX_die_offset: 0x00000012
# CHECK-NEXT:       }
# CHECK-NEXT:       Entry @ {{.*}} {
# CHECK-NEXT:         Abbrev: 0x3
# CHECK-NEXT:         Tag: DW_TAG_subprogram
# CHECK-NEXT:         DW_IDX_compile_unit: 0x01
# CHECK-NEXT:         DW_IDX_die_offset: 0x00000011
# CHECK-NEXT:       }
# CHECK:            String: {{.*}} "int"
# CHECK:              Tag: DW_TAG_base_type
# CHECK:            String: {{.*}} "S"
# CHECK:              Tag: DW_TAG_structure_type
# CHECK:            String: {{.*}} "_Z1fIiEvv"
# CHECK:              Tag: DW_TAG_subprogram
# CHECK:              Tag: DW_TAG_subprogram
# CHECK:            String: {{.*}} "ns"
# CHECK:              Tag: DW_TAG_namespace
# CHECK:            String: {{.*}} "f"
# CHECK:              Tag: DW_TAG_subprogram
# CHECK:              Tag: DW_TAG_subprogram

#--- a.s
_f:
  ret

.section __DWARF,__debug_abbrev,regular,debug
## 1: compile_unit, with children: name
.byte 1, 0x11, 1,  0x03, 0x08,  0, 0
## 2: namespace, with children: name
.byte 2, 0x39, 1,  0x03, 0x08,  0, 0
## 3: structure_type: name, byte_size
.byte 3, 0x13, 0,  0x03, 0x08,  0x0b, 0x0b,  0, 0
## 4: subprogram: name, linkage_name, low_pc, high_pc, type
.byte 4, 0x2e, 0,  0x03, 0x08,  0x6e, 0x08,  0x11, 0x01,  0x12, 0x06
.byte 0x49, 0x13,  0, 0
## 5: base_type: name, encoding, byte_size
.byte 5, 0x24, 0,  0x03, 0x08,  0x3e, 0x0b,  0x0b, 0x0b,  0, 0
## 6: pointer_type: type
.byte 6, 0x0f, 0,  0x49, 0x13,  0, 0
## 7: structure_type: name, declaration
.byte 7, 0x13, 0,  0x03, 0x08,  0x3c, 0x19,  0, 0
.byte 0

.section __DWARF,__debug_info,regular,debug
Lcu:
.long Lcu_end - Lcu - 4
.short VERSION
.if VERSION == 5
.byte 1                          ; DW_UT_compile
.byte 8
.long 0
.else
.long 0
.byte 8
.endif
.byte 1
.asciz "a.cc"
  .byte 4
  .asciz "f<int>"
  .asciz "_Z1fIiEvv"
  .quad _f
  .long 4
  .long Lptr - Lcu
  .byte 2
  .asciz "ns"
Ls:
    .byte 3
    .asciz "S"
    .byte 4
Ldecl:
    .byte 7
    .asciz "Decl"
  .byte 0
Lptr:
  .byte 6
  .long Ls - Lcu
  .byte 6
  .long Ldecl - Lcu
  .byte 5
  .asciz "int"
  .byte 5, 4
.byte 0
Lcu_end:
