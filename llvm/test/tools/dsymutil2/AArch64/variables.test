## Variables. A variable outside of functions is kept if it is at the address
## of a symbol of the debug map, or if it is a constant. Addresses in
## location expressions are those of the binary in the dSYM: the operand of
## DW_OP_addr, and a constant that the next operation takes for the address
## of a thread-local variable. Location lists are moved with their function
## into __debug_loc.
##
##  - g, t (thread-local) and s (static in f) are at symbols of the debug map.
##    The symbol of s has the ".llvm.<hash>" in the object file that ThinLTO
##    adds to a local symbol that another module uses. Xcode's ld leaves
##    that out of the debug map.
##  - c is a constant. So is k, which is in f, and so is bytes, whose value
##    is a block of bytes that starts like an expression with an address
##    would. It is left alone.
##  - m is a constant in the type S: what DWARF 5 has for a static member of
##    a class. Nothing else uses S, which is kept for it; Unused is not.
##  - ptr is a pointer to g, not a variable at an address.
##  - dead is at a symbol that the binary does not have. It is dropped.
##  - ext is at a symbol that the object file does not define. Its address in
##    the object file is 0, where e is, which is in the binary. A relocation
##    says that the address is not 0, and ext is dropped.
##  - com is a common symbol, a C variable without an initial value: the
##    object file has a size for it and no address. A relocation says which
##    symbol it is, and the debug map where that is in the binary.
##  - gone is a static in f whose symbol the binary does not have. It stays
##    with f; its location becomes operations that do nothing.
##  - fn, a parameter of f, is a pointer to that symbol. It is not a
##    variable, and its value becomes 0, as with dsymutil.
##  - targ is a pointer to the symbol of ext, the way clang describes a
##    template argument that is a function of another file. Its value is 0
##    in the object file as well, and it stays 0, as with dsymutil: it is
##    not the address of e.
##  - p, a parameter of f, has a location list. f is at 8 in the object file
##    and at 0x1000 in the binary.
##
## __apple_names has the variables that are at an address, and the constants
## outside of functions.

# RUN: rm -rf %t && split-file %s %t && cd %t
# RUN: llvm-mc -triple arm64-apple-macosx -filetype=obj a.s -o a.o
# RUN: %python %S/../Inputs/make-binary.py main \
# RUN:   object:a.o fn:_f:0x1000:8 fn:_e:0x1008:4 \
# RUN:   global:_g:0x4000 static:_s:0x4008 static:_t:0x4010 \
# RUN:   global:_com:0x4018
# RUN: dsymutil2 main -o main.dSYM
# RUN: llvm-dwarfdump --verify main.dSYM
# RUN: llvm-dwarfdump --debug-info main.dSYM | FileCheck %s \
# RUN:   --implicit-check-not='"dead"' --implicit-check-not='"ext"' \
# RUN:   --implicit-check-not=Unused
# RUN: llvm-dwarfdump --apple-names main.dSYM | FileCheck %s \
# RUN:   --check-prefix=NAMES --implicit-check-not=ptr \
# RUN:   --implicit-check-not=gone --implicit-check-not='"k"'

# CHECK:      DW_TAG_compile_unit
# CHECK:        DW_TAG_variable
# CHECK-NEXT:     DW_AT_name ("g")
# CHECK-NEXT:     DW_AT_location (DW_OP_addr 0x4000)
# CHECK:        DW_TAG_variable
# CHECK-NEXT:     DW_AT_name ("com")
# CHECK-NEXT:     DW_AT_location (DW_OP_addr 0x4018)
# CHECK:        DW_TAG_variable
# CHECK-NEXT:     DW_AT_name ("c")
# CHECK-NEXT:     DW_AT_const_value (0x05)
# CHECK:        DW_TAG_variable
# CHECK-NEXT:     DW_AT_name ("bytes")
# CHECK-NEXT:     DW_AT_const_value (<0x04> 03 00 00 00 )
# CHECK:        DW_TAG_variable
# CHECK-NEXT:     DW_AT_name ("t")
# CHECK-NEXT:     DW_AT_location (DW_OP_const8u 0x4010, DW_OP_form_tls_address)
# CHECK:        DW_TAG_variable
# CHECK-NEXT:     DW_AT_name ("ptr")
# CHECK-NEXT:     DW_AT_location (DW_OP_addr 0x4000, DW_OP_stack_value)
# CHECK:        DW_TAG_structure_type
# CHECK-NEXT:     DW_AT_name ("S")
# CHECK:          DW_TAG_variable
# CHECK-NEXT:       DW_AT_name ("m")
# CHECK-NEXT:       DW_AT_const_value (0x09)
# CHECK:        DW_TAG_subprogram
# CHECK-NEXT:     DW_AT_name ("e")
# CHECK:        DW_TAG_subprogram
# CHECK-NEXT:     DW_AT_name ("f")
# CHECK:          DW_TAG_formal_parameter
# CHECK-NEXT:       DW_AT_name ("p")
# CHECK-NEXT:       DW_AT_location (0x00000000:
# CHECK-NEXT:          [0x0000000000001000, 0x0000000000001004): DW_OP_reg0 W0
# CHECK-NEXT:          [0x0000000000001004, 0x0000000000001008): DW_OP_breg1 W1+0)
# CHECK:          DW_TAG_variable
# CHECK-NEXT:       DW_AT_name ("s")
# CHECK-NEXT:       DW_AT_location (DW_OP_addr 0x4008)
# CHECK:          DW_TAG_variable
# CHECK-NEXT:       DW_AT_name ("gone")
# CHECK-NEXT:       DW_AT_location (DW_OP_nop, DW_OP_nop, DW_OP_nop, DW_OP_nop, DW_OP_nop, DW_OP_nop, DW_OP_nop, DW_OP_nop, DW_OP_nop)
# CHECK:          DW_TAG_variable
# CHECK-NEXT:       DW_AT_name ("k")
# CHECK-NEXT:       DW_AT_const_value (0x07)
# CHECK:          DW_TAG_formal_parameter
# CHECK-NEXT:       DW_AT_name ("fn")
# CHECK-NEXT:       DW_AT_location (DW_OP_addr 0x0, DW_OP_stack_value)
# CHECK:          DW_TAG_template_value_parameter
# CHECK-NEXT:       DW_AT_type ({{.*}} "uintptr_t")
# CHECK-NEXT:       DW_AT_name ("targ")
# CHECK-NEXT:       DW_AT_location (DW_OP_addr 0x0, DW_OP_stack_value)

# NAMES-DAG: String: {{.*}} "g"
# NAMES-DAG: String: {{.*}} "c"
# NAMES-DAG: String: {{.*}} "com"
# NAMES-DAG: String: {{.*}} "t"
# NAMES-DAG: String: {{.*}} "s"
# NAMES-DAG: String: {{.*}} "m"

#--- a.s
_e:
  ret
_pad:
  ret
_f:
  ret
  ret

.data
_g:
  .quad 0
_s.llvm.123:
  .quad 0
_t:
  .quad 0
_dead:
  .quad 0
.comm _com, 8

.section __DWARF,__debug_abbrev,regular,debug
## 1: compile_unit, with children: low_pc, high_pc
.byte 1, 0x11, 1,  0x11, 0x01,  0x12, 0x06,  0, 0
## 2: variable: name, location (exprloc)
.byte 2, 0x34, 0,  0x03, 0x0e,  0x02, 0x18,  0, 0
## 3: variable: name, const_value
.byte 3, 0x34, 0,  0x03, 0x0e,  0x1c, 0x0b,  0, 0
## 4: subprogram, with children: name, low_pc, high_pc
.byte 4, 0x2e, 1,  0x03, 0x0e,  0x11, 0x01,  0x12, 0x06,  0, 0
## 5: formal_parameter: name, location (sec_offset)
.byte 5, 0x05, 0,  0x03, 0x0e,  0x02, 0x17,  0, 0
## 6: subprogram: name, low_pc, high_pc
.byte 6, 0x2e, 0,  0x03, 0x0e,  0x11, 0x01,  0x12, 0x06,  0, 0
## 7: formal_parameter: name, location (exprloc)
.byte 7, 0x05, 0,  0x03, 0x0e,  0x02, 0x18,  0, 0
## 8: variable: name, const_value (block1)
.byte 8, 0x34, 0,  0x03, 0x0e,  0x1c, 0x0a,  0, 0
## 9: template_value_parameter: type, name, location (exprloc)
.byte 9, 0x30, 0,  0x49, 0x13,  0x03, 0x0e,  0x02, 0x18,  0, 0
## 10: base_type: name, encoding, byte_size
.byte 10, 0x24, 0,  0x03, 0x0e,  0x3e, 0x0b,  0x0b, 0x0b,  0, 0
## 11: structure_type, with children: name
.byte 11, 0x13, 1,  0x03, 0x0e,  0, 0
.byte 0

.section __DWARF,__debug_info,regular,debug
Lcu:
.long Lcu_end - Lcu - 4
.short 4
.long 0
.byte 8
.byte 1                          ; compile_unit
.quad _e
.long 16
  .byte 2                        ; g
  .long Lstr_g - Lstr
  .byte 9, 0x03                  ; DW_OP_addr
  .quad _g
  .byte 2                        ; dead
  .long Lstr_dead - Lstr
  .byte 9, 0x03
  .quad _dead
  .byte 2                        ; ext
  .long Lstr_ext - Lstr
  .byte 9, 0x03
  .quad _ext
  .byte 2                        ; com
  .long Lstr_com - Lstr
  .byte 9, 0x03
  .quad _com
  .byte 3                        ; c
  .long Lstr_c - Lstr
  .byte 5
  .byte 8                        ; bytes
  .long Lstr_bytes - Lstr
  .byte 4, 0x03, 0, 0, 0
  .byte 2                        ; t
  .long Lstr_t - Lstr
  .byte 10, 0x0e                 ; DW_OP_const8u
  .quad _t
  .byte 0x9b                     ; DW_OP_form_tls_address
  .byte 2                        ; ptr
  .long Lstr_ptr - Lstr
  .byte 10, 0x03
  .quad _g
  .byte 0x9f                     ; DW_OP_stack_value
  .byte 11                       ; S
  .long Lstr_S - Lstr
    .byte 3                      ; m
    .long Lstr_m - Lstr
    .byte 9
  .byte 0
  .byte 11                       ; Unused
  .long Lstr_Unused - Lstr
    .byte 2                      ; a variable that is not a constant
    .long Lstr_m - Lstr
    .byte 9, 0x03
    .quad _dead
  .byte 0
  .byte 6                        ; e
  .long Lstr_e - Lstr
  .quad _e
  .long 4
  .byte 4                        ; f
  .long Lstr_f - Lstr
  .quad _f
  .long 8
    .byte 5                      ; p
    .long Lstr_p - Lstr
    .long 0
    .byte 2                      ; s
    .long Lstr_s - Lstr
    .byte 9, 0x03
    .quad _s.llvm.123
    .byte 2                      ; gone
    .long Lstr_gone - Lstr
    .byte 9, 0x03
    .quad _dead
    .byte 3                      ; k
    .long Lstr_k - Lstr
    .byte 7
    .byte 7                      ; fn
    .long Lstr_fn - Lstr
    .byte 10, 0x03
    .quad _dead
    .byte 0x9f                   ; DW_OP_stack_value
    .byte 9                      ; targ
    .long Lptr - Lcu
    .long Lstr_targ - Lstr
    .byte 10, 0x03
    .quad _ext
    .byte 0x9f                   ; DW_OP_stack_value
  .byte 0
Lptr:
  .byte 10                       ; the type of targ
  .long Lstr_ptr_type - Lstr
  .byte 7, 8                     ; DW_ATE_unsigned, 8 bytes
.byte 0
Lcu_end:

.section __DWARF,__debug_loc,regular,debug
## Addresses are relative to the unit's low_pc, which is 0 here.
.quad 8, 12
.short 1
.byte 0x50                       ; DW_OP_reg0
.quad 12, 16
.short 2
.byte 0x71, 0                    ; DW_OP_breg1 0
.quad 0, 0

.section __DWARF,__debug_str,regular,debug
Lstr:
Lstr_g:
  .asciz "g"
Lstr_dead:
  .asciz "dead"
Lstr_ext:
  .asciz "ext"
Lstr_c:
  .asciz "c"
Lstr_com:
  .asciz "com"
Lstr_t:
  .asciz "t"
Lstr_ptr:
  .asciz "ptr"
Lstr_e:
  .asciz "e"
Lstr_f:
  .asciz "f"
Lstr_p:
  .asciz "p"
Lstr_s:
  .asciz "s"
Lstr_gone:
  .asciz "gone"
Lstr_k:
  .asciz "k"
Lstr_fn:
  .asciz "fn"
Lstr_targ:
  .asciz "targ"
Lstr_ptr_type:
  .asciz "uintptr_t"
Lstr_bytes:
  .asciz "bytes"
Lstr_S:
  .asciz "S"
Lstr_m:
  .asciz "m"
Lstr_Unused:
  .asciz "Unused"
