## Address ranges.
##  - A unit's low_pc and high_pc cover its functions that are in the binary,
##    wherever the linker put them.
##  - A unit that has DW_AT_ranges gets the list of those functions.
##  - Other range lists are translated entry by entry, relative to the
##    unit's new low_pc. Entries for code that is not in the binary go.
##  - __debug_aranges lists every unit's functions. lldb relies on it being
##    complete in a dSYM.
##  - A function that the debug map has no size for (_b3) extends to the next
##    symbol of its object file.

# RUN: rm -rf %t && split-file %s %t && cd %t
# RUN: llvm-mc -triple arm64-apple-macosx -filetype=obj a.s -o a.o
# RUN: llvm-mc -triple arm64-apple-macosx -filetype=obj b.s -o b.o
# RUN: %python %S/../Inputs/make-binary.py main \
# RUN:   object:a.o fn:_g:0x1000:8 fn:_f:0x2000:16 \
# RUN:   object:b.o fn:_b1:0x3000:4 fn:_b3:0x1800:0
# RUN: dsymutil2 main -o main.dSYM
# RUN: llvm-dwarfdump --verify main.dSYM
# RUN: llvm-dwarfdump --debug-info --debug-aranges main.dSYM | FileCheck %s

# CHECK:      DW_TAG_compile_unit
# CHECK-NEXT:   DW_AT_low_pc (0x0000000000001000)
# CHECK-NEXT:   DW_AT_high_pc (0x0000000000002010)
# CHECK:        DW_TAG_subprogram
# CHECK-NEXT:     DW_AT_low_pc (0x0000000000002000)
# CHECK-NEXT:     DW_AT_high_pc (0x0000000000002010)
# CHECK:          DW_TAG_lexical_block
# CHECK-NEXT:       DW_AT_ranges (0x00000000
# CHECK-NEXT:          [0x0000000000002004, 0x0000000000002008)
# CHECK-NEXT:          [0x000000000000200c, 0x0000000000002010))
# CHECK:        DW_TAG_subprogram
# CHECK-NEXT:     DW_AT_low_pc (0x0000000000001000)
# CHECK-NEXT:     DW_AT_high_pc (0x0000000000001008)

# CHECK:      DW_TAG_compile_unit
# CHECK-NEXT:   DW_AT_low_pc (0x0000000000001800)
# CHECK-NEXT:   DW_AT_ranges (0x00000030
# CHECK-NEXT:      [0x0000000000001800, 0x0000000000001804)
# CHECK-NEXT:      [0x0000000000003000, 0x0000000000003004))

# CHECK:      .debug_aranges contents:
# CHECK-NEXT: Address Range Header: length = 0x0000003c, format = DWARF32, version = 0x0002, cu_offset = 0x00000000, addr_size = 0x08, seg_size = 0x00
# CHECK-NEXT: [0x0000000000001000, 0x0000000000001008)
# CHECK-NEXT: [0x0000000000002000, 0x0000000000002010)
# CHECK-NEXT: Address Range Header: length = 0x0000003c, format = DWARF32, version = 0x0002, cu_offset = 0x{{[0-9a-f]+}}, addr_size = 0x08, seg_size = 0x00
# CHECK-NEXT: [0x0000000000001800, 0x0000000000001804)
# CHECK-NEXT: [0x0000000000003000, 0x0000000000003004)

#--- a.s
_f:
  ret
  ret
  ret
  ret
_dead:
  ret
_g:
  ret
  ret

.section __DWARF,__debug_abbrev,regular,debug
## 1: compile_unit, with children: low_pc, high_pc
.byte 1, 0x11, 1,  0x11, 0x01,  0x12, 0x06,  0, 0
## 2: subprogram, with children: low_pc, high_pc
.byte 2, 0x2e, 1,  0x11, 0x01,  0x12, 0x06,  0, 0
## 3: lexical_block: ranges
.byte 3, 0x0b, 0,  0x55, 0x17,  0, 0
.byte 0

.section __DWARF,__debug_info,regular,debug
Lcu:
.long Lcu_end - Lcu - 4
.short 4
.long 0
.byte 8
.byte 1                          ; compile_unit
.quad _f
.long 28
  .byte 2                        ; subprogram f
  .quad _f
  .long 16
    .byte 3                      ; lexical_block
    .long 0
  .byte 0
  .byte 2                        ; subprogram dead
  .quad _dead
  .long 4
    .byte 3                      ; lexical_block
    .long 64
  .byte 0
  .byte 2                        ; subprogram g
  .quad _g
  .long 8
  .byte 0
.byte 0
Lcu_end:

.section __DWARF,__debug_ranges,regular,debug
## In f.
.quad 4, 6
.quad 6, 8
.quad 12, 16
.quad 0, 0
## In dead.
.quad 16, 18
.quad 18, 20
.quad 0, 0

#--- b.s
_b1:
  ret
_b2:
  ret
_b3:
  ret
_b4:
  ret

.section __DWARF,__debug_abbrev,regular,debug
## 1: compile_unit, with children: low_pc, ranges
.byte 1, 0x11, 1,  0x11, 0x01,  0x55, 0x17,  0, 0
## 2: subprogram: low_pc, high_pc
.byte 2, 0x2e, 0,  0x11, 0x01,  0x12, 0x06,  0, 0
.byte 0

.section __DWARF,__debug_info,regular,debug
Lcu:
.long Lcu_end - Lcu - 4
.short 4
.long 0
.byte 8
.byte 1                          ; compile_unit
.quad 0
.long 0
  .byte 2                        ; subprogram b1
  .quad _b1
  .long 4
  .byte 2                        ; subprogram b2
  .quad _b2
  .long 4
  .byte 2                        ; subprogram b3
  .quad _b3
  .long 4
.byte 0
Lcu_end:

.section __DWARF,__debug_ranges,regular,debug
.quad 0, 12
.quad 0, 0
