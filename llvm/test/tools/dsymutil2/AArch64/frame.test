## __debug_frame: the frame descriptions (FDEs) of functions that are in the
## binary are kept, at the functions' linked addresses. Those of other
## functions are dropped. A CIE that several object files use is written
## once, by the first of them, and all their FDEs point at it.

# RUN: rm -rf %t && split-file %s %t && cd %t
# RUN: llvm-mc -triple arm64-apple-macosx -filetype=obj a.s -o a.o
# RUN: llvm-mc -triple arm64-apple-macosx -filetype=obj a.s -o b.o \
# RUN:   --defsym SECOND=1
# RUN: %python %S/../Inputs/make-binary.py main \
# RUN:   object:a.o fn:_g:0x1000:12 fn:_f:0x2000:12 \
# RUN:   object:b.o fn:_f2:0x1800:12
# RUN: dsymutil2 main -o main.dSYM
# RUN: llvm-dwarfdump --verify main.dSYM
# RUN: llvm-dwarfdump --debug-frame main.dSYM | FileCheck %s \
# RUN:   --implicit-check-not=CIE --implicit-check-not=FDE

# CHECK:      .debug_frame contents:
# CHECK:      00000000 {{[0-9a-f]+}} ffffffff CIE
# CHECK:      00000018 {{[0-9a-f]+}} 00000000 FDE cie=00000000 pc=00002000...0000200c
# CHECK:        DW_CFA_def_cfa_offset: +16
# CHECK:      {{[0-9a-f]+}} {{[0-9a-f]+}} 00000000 FDE cie=00000000 pc=00001000...0000100c
# CHECK:        DW_CFA_def_cfa_offset: +48
# CHECK:      {{[0-9a-f]+}} {{[0-9a-f]+}} 00000000 FDE cie=00000000 pc=00001800...0000180c
# CHECK:        DW_CFA_def_cfa_offset: +16

## The binary's __eh_frame, which is copied as it is.
# CHECK:      .eh_frame contents:
# CHECK:      00000000 0000000c 00000000 CIE

#--- a.s
.cfi_sections .debug_frame

.ifdef SECOND
_f2:
.else
_f:
.endif
  .cfi_startproc
  sub sp, sp, #16
  .cfi_def_cfa_offset 16
  add sp, sp, #16
  ret
  .cfi_endproc

_dead:
  .cfi_startproc
  sub sp, sp, #32
  .cfi_def_cfa_offset 32
  add sp, sp, #32
  ret
  .cfi_endproc

.ifndef SECOND
_g:
  .cfi_startproc
  sub sp, sp, #48
  .cfi_def_cfa_offset 48
  add sp, sp, #48
  ret
  .cfi_endproc
.endif

## A unit, so that the object files have debug info at all.
.section __DWARF,__debug_abbrev,regular,debug
.byte 1, 0x11, 1,  0, 0
.byte 2, 0x2e, 0,  0x11, 0x01,  0x12, 0x06,  0, 0
.byte 0

.section __DWARF,__debug_info,regular,debug
Lcu:
.long Lcu_end - Lcu - 4
.short 4
.long 0
.byte 8
.byte 1
  .byte 2
.ifdef SECOND
  .quad _f2
.else
  .quad _f
.endif
  .long 12
.byte 0
Lcu_end:
