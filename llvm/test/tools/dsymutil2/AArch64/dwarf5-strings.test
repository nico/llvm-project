## DWARF 5: the units' header, and strings that entries name by their index
## in a table of the unit, which is in __debug_str_offs and has the strings'
## offsets in __debug_str. The entries keep their bytes but for the index:
## the output's table has the slots that kept entries use, in their order, so
## that an index only gets smaller and fits where the old one was. An index
## of variable size keeps its size.
##
## Both units use the same table, as compilers have it. Of its 143 slots, the
## kept entries use 0, 1, 3, 140, 141 and 142; dead uses 2 and 4.

# RUN: rm -rf %t && split-file %s %t && cd %t
# RUN: llvm-mc -triple arm64-apple-macosx -filetype=obj a.s -o a.o
# RUN: %python %S/../Inputs/make-binary.py main \
# RUN:   object:a.o fn:_f:0x1000:4 fn:_g:0x1004:4
# RUN: dsymutil2 main -o main.dSYM
# RUN: llvm-dwarfdump --verify main.dSYM
# RUN: llvm-dwarfdump -v --debug-info main.dSYM | FileCheck %s \
# RUN:   --implicit-check-not=dead
# RUN: llvm-dwarfdump --debug-str-offsets --debug-str main.dSYM \
# RUN:   | FileCheck %s --check-prefix=TABLE --implicit-check-not=dead \
# RUN:     --implicit-check-not=unused
# RUN: llvm-dwarfdump --apple-names main.dSYM | FileCheck %s \
# RUN:   --check-prefix=NAMES

# CHECK:      Compile Unit: {{.*}} version = 0x0005, unit_type = DW_UT_compile, abbr_offset = 0x0000, addr_size = 0x08
# CHECK:      DW_TAG_compile_unit
# CHECK-NEXT:   DW_AT_name [DW_FORM_strx1] (indexed (00000001) string = "a.cc")
# CHECK-NEXT:   DW_AT_str_offsets_base [DW_FORM_sec_offset] (0x00000008)
# CHECK:        DW_TAG_subprogram
# CHECK-NEXT:     DW_AT_name [DW_FORM_strx1] (indexed (00000002) string = "f")
# CHECK-NEXT:     DW_AT_linkage_name [DW_FORM_strx] (indexed (00000003) string = "_Z1fv")
# CHECK-NEXT:     DW_AT_low_pc [DW_FORM_addr] (0x0000000000001000)
# CHECK:      Compile Unit: {{.*}} version = 0x0005
# CHECK:      DW_TAG_compile_unit
# CHECK-NEXT:   DW_AT_name [DW_FORM_strx2] (indexed (00000004) string = "b.cc")
# CHECK-NEXT:   DW_AT_str_offsets_base [DW_FORM_sec_offset] (0x00000008)
# CHECK:        DW_TAG_subprogram
# CHECK-NEXT:     DW_AT_name [DW_FORM_strx4] (indexed (00000005) string = "g")
# CHECK-NEXT:     DW_AT_linkage_name [DW_FORM_strx3] (indexed (00000000) string = "first")
# CHECK-NEXT:     DW_AT_low_pc [DW_FORM_addr] (0x0000000000001004)

# TABLE:      .debug_str contents:
# TABLE-NEXT: 0x00000000: ""
# TABLE-NEXT: 0x00000001: "first"
# TABLE-NEXT: 0x00000007: "a.cc"
# TABLE-NEXT: 0x0000000c: "f"
# TABLE-NEXT: 0x0000000e: "_Z1fv"
# TABLE-NEXT: 0x00000014: "b.cc"
# TABLE-NEXT: 0x00000019: "g"
# TABLE:      .debug_str_offsets contents:
# TABLE-NEXT: 0x00000000: Contribution size = 28, Format = DWARF32, Version = 5
# TABLE-NEXT: 0x00000008: 00000001 "first"
# TABLE-NEXT: 0x0000000c: 00000007 "a.cc"
# TABLE-NEXT: 0x00000010: 0000000c "f"
# TABLE-NEXT: 0x00000014: 0000000e "_Z1fv"
# TABLE-NEXT: 0x00000018: 00000014 "b.cc"
# TABLE-NEXT: 0x0000001c: 00000019 "g"
# TABLE-EMPTY:

# NAMES-DAG: String: {{.*}} "f"
# NAMES-DAG: String: {{.*}} "_Z1fv"
# NAMES-DAG: String: {{.*}} "g"
# NAMES-DAG: String: {{.*}} "first"

#--- a.s
_f:
  ret
_dead:
  ret
_g:
  ret

.section __DWARF,__debug_abbrev,regular,debug
## 1: compile_unit, with children: name (strx1), str_offsets_base
.byte 1, 0x11, 1,  0x03, 0x25,  0x72, 0x17,  0, 0
## 2: subprogram: name (strx1), linkage_name (strx), low_pc, high_pc
.byte 2, 0x2e, 0,  0x03, 0x25,  0x6e, 0x1a,  0x11, 0x01,  0x12, 0x06,  0, 0
## 3: subprogram: name (strx4), linkage_name (strx3), low_pc, high_pc
.byte 3, 0x2e, 0,  0x03, 0x28,  0x6e, 0x27,  0x11, 0x01,  0x12, 0x06,  0, 0
## 4: compile_unit, with children: name (strx2), str_offsets_base
.byte 4, 0x11, 1,  0x03, 0x26,  0x72, 0x17,  0, 0
.byte 0

.section __DWARF,__debug_info,regular,debug
Lcu1:
.long Lcu1_end - Lcu1 - 4
.short 5
.byte 1                          ; DW_UT_compile
.byte 8
.long 0
.byte 1                          ; compile_unit
.byte 1                          ; a.cc
.long Ltable - Loffsets
  .byte 2                        ; f
  .byte 3
  .byte 0x8c, 0x01               ; 140, in two bytes
  .quad _f
  .long 4
  .byte 2                        ; dead
  .byte 2
  .byte 4
  .quad _dead
  .long 4
.byte 0
Lcu1_end:
Lcu2:
.long Lcu2_end - Lcu2 - 4
.short 5
.byte 1
.byte 8
.long 0
.byte 4                          ; compile_unit
.short 141                       ; b.cc
.long Ltable - Loffsets
  .byte 3                        ; g
  .long 142
  .byte 0, 0, 0                  ; first
  .quad _g
  .long 4
.byte 0
Lcu2_end:

.section __DWARF,__debug_str_offs,regular,debug
Loffsets:
.long Ltable_end - Loffsets - 4
.short 5
.short 0
Ltable:
.long Lstr_first - Lstr
.long Lstr_a - Lstr
.long Lstr_dead - Lstr
.long Lstr_f - Lstr
.long Lstr_Zdead - Lstr
.rept 135
.long Lstr_unused - Lstr
.endr
.long Lstr_Zf - Lstr
.long Lstr_b - Lstr
.long Lstr_g - Lstr
Ltable_end:

.section __DWARF,__debug_str,regular,debug
Lstr:
Lstr_unused:
  .asciz "unused"
Lstr_first:
  .asciz "first"
Lstr_a:
  .asciz "a.cc"
Lstr_dead:
  .asciz "dead"
Lstr_f:
  .asciz "f"
Lstr_Zdead:
  .asciz "_Zdead"
Lstr_Zf:
  .asciz "_Z1fv"
Lstr_b:
  .asciz "b.cc"
Lstr_g:
  .asciz "g"
