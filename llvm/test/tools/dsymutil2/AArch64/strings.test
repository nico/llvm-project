## The strings that kept entries use are merged into one __debug_str. Every
## string is written by the first object file that uses it, in the order of
## that file's section; strings that nothing kept uses are dropped. An empty
## string comes first: offset 0 means something else in the accelerator
## tables. The result does not depend on the number of threads.

# RUN: rm -rf %t && split-file %s %t && cd %t
# RUN: llvm-mc -triple arm64-apple-macosx -filetype=obj a.s -o a.o
# RUN: llvm-mc -triple arm64-apple-macosx -filetype=obj b.s -o b.o
# RUN: %python %S/../Inputs/make-binary.py main \
# RUN:   object:a.o fn:_a:0x1000:4 object:b.o fn:_b:0x1004:4
# RUN: dsymutil2 main -o main.dSYM
# RUN: llvm-dwarfdump --debug-str main.dSYM | FileCheck %s --check-prefix=STR
# RUN: llvm-dwarfdump --debug-info main.dSYM | FileCheck %s

## __debug_str is the last section: it is the largest one of a large dSYM,
## and a reader that cannot find sections past 4 GiB in the file then finds
## as many as possible.
# RUN: llvm-readobj --sections main.dSYM/Contents/Resources/DWARF/main \
# RUN:   | FileCheck %s --check-prefix=ORDER
# ORDER:     Name: __debug_info
# ORDER:     Name: __debug_str
# ORDER-NOT: Name:

# RUN: dsymutil2 -j 1 main -o serial.dSYM
# RUN: cmp main.dSYM/Contents/Resources/DWARF/main \
# RUN:   serial.dSYM/Contents/Resources/DWARF/main

# STR:      .debug_str contents:
# STR-NEXT: 0x00000000: ""
# STR-NEXT: 0x00000001: "x.cc"
# STR-NEXT: 0x00000006: "common"
# STR-NEXT: 0x0000000d: "only_a"
# STR-NEXT: 0x00000014: "only_b"
# STR-EMPTY:

# CHECK:      DW_TAG_compile_unit
# CHECK-NEXT:   DW_AT_name ("x.cc")
# CHECK:        DW_TAG_subprogram
# CHECK-NEXT:     DW_AT_name ("common")
# CHECK-NEXT:     DW_AT_linkage_name ("only_a")
# CHECK:      DW_TAG_compile_unit
# CHECK-NEXT:   DW_AT_name ("x.cc")
# CHECK:        DW_TAG_subprogram
# CHECK-NEXT:     DW_AT_name ("common")
# CHECK-NEXT:     DW_AT_linkage_name ("only_b")

#--- a.s
_a:
  ret

.section __DWARF,__debug_abbrev,regular,debug
## 1: compile_unit, with children: name
.byte 1, 0x11, 1,  0x03, 0x0e,  0, 0
## 2: subprogram: name, linkage_name, low_pc, high_pc
.byte 2, 0x2e, 0,  0x03, 0x0e,  0x6e, 0x0e,  0x11, 0x01,  0x12, 0x06,  0, 0
.byte 0

.section __DWARF,__debug_info,regular,debug
Lcu:
.long Lcu_end - Lcu - 4
.short 4
.long 0
.byte 8
.byte 1
.long Lstr_file - Lstr
  .byte 2
  .long Lstr_common - Lstr
  .long Lstr_only - Lstr
  .quad _a
  .long 4
.byte 0
Lcu_end:

.section __DWARF,__debug_str,regular,debug
Lstr:
  .asciz "unused"
Lstr_file:
  .asciz "x.cc"
Lstr_common:
  .asciz "common"
Lstr_only:
  .asciz "only_a"

#--- b.s
_b:
  ret

.section __DWARF,__debug_abbrev,regular,debug
.byte 1, 0x11, 1,  0x03, 0x0e,  0, 0
.byte 2, 0x2e, 0,  0x03, 0x0e,  0x6e, 0x0e,  0x11, 0x01,  0x12, 0x06,  0, 0
.byte 0

.section __DWARF,__debug_info,regular,debug
Lcu:
.long Lcu_end - Lcu - 4
.short 4
.long 0
.byte 8
.byte 1
.long Lstr_file - Lstr
  .byte 2
  .long Lstr_common - Lstr
  .long Lstr_only - Lstr
  .quad _b
  .long 4
.byte 0
Lcu_end:

.section __DWARF,__debug_str,regular,debug
Lstr:
Lstr_common:
  .asciz "common"
Lstr_only:
  .asciz "only_b"
Lstr_file:
  .asciz "x.cc"
