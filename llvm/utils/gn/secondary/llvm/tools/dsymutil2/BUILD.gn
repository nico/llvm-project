import("//llvm/utils/TableGen/tablegen.gni")

tablegen("Options") {
  visibility = [ ":dsymutil2" ]
  args = [ "-gen-opt-parser-defs" ]
}

executable("dsymutil2") {
  deps = [
    ":Options",
    "//llvm/lib/BinaryFormat",
    "//llvm/lib/DebugInfo/DWARF",
    "//llvm/lib/DebugInfo/DWARF/LowLevel",
    "//llvm/lib/Object",
    "//llvm/lib/Option",
    "//llvm/lib/Support",
    "//llvm/lib/TargetParser",
  ]
  sources = [
    "AccelTable.cpp",
    "DebugMap.cpp",
    "DsymWriter.cpp",
    "Dwarf.cpp",
    "DwarfLinker.cpp",
    "FrameTable.cpp",
    "LineTable.cpp",
    "MachOFile.cpp",
    "ObjectFile.cpp",
    "StringTable.cpp",
    "dsymutil2.cpp",
  ]
}
